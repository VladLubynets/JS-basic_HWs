  },
  "item": [
    {
      "name": "Is Valid ISBN13 Number",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = xml2Json(pm.response.text());",
              "var result = jsonData[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN13Response\"][\"m:IsValidISBN13Result\"];",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type header is present\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "});",
              "",
              "pm.test(\"Content-Type is text/xml\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
              "});",
              "",
              "pm.test(\"Charset is utf-8\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"utf-8\");",
              "});",
              "",
              "pm.test(\"Date header is present\", function () {",
              "    pm.response.to.have.header(\"Date\");",
              "});",
              "",
              "pm.test(\"Response body is not empty\", function () {",
              "    pm.expect(pm.response.text()).to.not.be.empty;",
              "});",
              "",
              "pm.test(\"Body has soap envelope\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"soap:Envelope\");",
              "});",
              "",
              "pm.test(\"Body has IsValidISBN13Response\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"IsValidISBN13Response\");",
              "});",
              "",
              "pm.test(\"There is no soap fault\", function () {",
              "    pm.expect(pm.response.text()).to.not.include(\"soap:Fault\");",
              "});",
              "",
              "pm.test(\"ISBN13 is valid\", function () {",
              "    pm.expect(result).to.eql(\"true\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "value": "text/xml; charset=utf-8",
            "key": "Content-Type"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>{{isbn13}}</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{url}}",
          "host": [
            "{{url}}"
          ]
        }
      },
      "response": []
    },
