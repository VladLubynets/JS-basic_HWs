{
  "info": {
    "name": "MongoDB Atlas homework",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Atlas cluster status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Cluster list is returned\", function () {",
              "    pm.expect(pm.response.json().results.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Cluster is IDLE\", function () {",
              "    pm.expect(pm.response.json().results[0].stateName).to.eql(\"IDLE\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "digest",
          "digest": [
            {
              "key": "username",
              "value": "{{atlasPublicKey}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{atlasPrivateKey}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.atlas.2024-08-05+json"
          }
        ],
        "url": {
          "raw": "https://cloud.mongodb.com/api/atlas/v2/groups/{{projectId}}/clusters",
          "protocol": "https",
          "host": [
            "cloud",
            "mongodb",
            "com"
          ],
          "path": [
            "api",
            "atlas",
            "v2",
            "groups",
            "{{projectId}}",
            "clusters"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has id\", function () {",
              "    pm.expect(pm.response.json()._id).to.be.a(\"string\");",
              "});",
              "",
              "pm.test(\"Name is Peter\", function () {",
              "    pm.expect(pm.response.json().name).to.eql(\"Peter\");",
              "});",
              "",
              "pm.environment.set(\"charId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/character",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "character"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Peter\",\n    \"age\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Get character by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Document is saved correctly\", function () {",
              "    pm.expect(pm.response.json().name).to.eql(\"Peter\");",
              "    pm.expect(pm.response.json().age).to.eql(20);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/character/{{charId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "character",
            "{{charId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Name is updated\", function () {",
              "    pm.expect(pm.response.json().name).to.eql(\"Maria\");",
              "});",
              "",
              "pm.test(\"Age is updated\", function () {",
              "    pm.expect(pm.response.json().age).to.eql(25);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/character/{{charId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "character",
            "{{charId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Maria\",\n    \"age\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Get updated character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Changes are saved in database\", function () {",
              "    pm.expect(pm.response.json().name).to.eql(\"Maria\");",
              "    pm.expect(pm.response.json().age).to.eql(25);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/character/{{charId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "character",
            "{{charId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get all characters with limit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Not more than 5 documents\", function () {",
              "    pm.expect(pm.response.json().length).to.be.at.most(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/characters?limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "characters"
          ],
          "query": [
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Filter characters by age",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"All documents have age 25\", function () {",
              "    pm.response.json().forEach(function (item) {",
              "        pm.expect(item.age).to.eql(25);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/characters?age=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "characters"
          ],
          "query": [
            {
              "key": "age",
              "value": "25"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Document is deleted\", function () {",
              "    pm.expect(pm.response.json().deleted).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/character/{{charId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "character",
            "{{charId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get deleted character",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Document is not in collection\", function () {",
              "    pm.expect(pm.response.json().error).to.eql(\"Character not found\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/character/{{charId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "character",
            "{{charId}}"
          ]
        }
      },
      "response": []
    }
  ]
}